From: ESP32-S31 Linux <s31-linux@example.invalid>
Subject: [PATCH] Use persistent host identity and pairing state

diff --git a/port/linux/main.c b/port/linux/main.c
--- a/port/linux/main.c
+++ b/port/linux/main.c
@@ -43,6 +43,7 @@
 //
 // *****************************************************************************
 
+#include <errno.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -78,7 +79,7 @@
     .device_id = 0,
 };
 
-#define TLV_DB_PATH_PREFIX "/tmp/btstack_"
+#define TLV_DB_PATH_PREFIX "/var/lib/btstack/btstack_"
 #define TLV_DB_PATH_POSTFIX ".tlv"
 static char tlv_db_path[100];
 static bool tlv_reset;
@@ -100,19 +101,24 @@
     switch (hci_event_packet_get_type(packet)){
         case BTSTACK_EVENT_STATE:
             switch(btstack_event_state_get_state(packet)){
-                case HCI_STATE_WORKING:
+                case HCI_STATE_WORKING: {
+                    const bool reset_requested = tlv_reset;
+                    bool reset_ok = true;
+                    /* A recovery event must not erase keys learned after -r. */
+                    tlv_reset = false;
                     gap_local_bd_addr(local_addr);
                     printf("BTstack up and running on %s.\n", bd_addr_to_str(local_addr));
                     btstack_strcpy(tlv_db_path, sizeof(tlv_db_path), TLV_DB_PATH_PREFIX);
                     btstack_strcat(tlv_db_path, sizeof(tlv_db_path), bd_addr_to_str_with_delimiter(local_addr, '-'));
                     btstack_strcat(tlv_db_path, sizeof(tlv_db_path), TLV_DB_PATH_POSTFIX);
                     printf("TLV path: %s", tlv_db_path);
-                    if (tlv_reset){
+                    if (reset_requested){
                         int rc = unlink(tlv_db_path);
-                        if (rc == 0) {
+                        reset_ok = (rc == 0 || errno == ENOENT);
+                        if (reset_ok) {
                             printf(", reset ok");
                         } else {
-                            printf(", reset failed with result = %d", rc);
+                            printf(", reset failed: %s", strerror(errno));
                         }
                     }
                     printf("\n");
@@ -124,7 +130,12 @@
 #ifdef ENABLE_BLE
                     le_device_db_tlv_configure(tlv_impl, &tlv_context);
 #endif
-                    break;
+                    if (reset_requested){
+                        printf("S31_PAIRING_RESET=%s\n", reset_ok ? "ok" : "failed");
+                        fflush(stdout);
+                    }
+                    break;
+                }
                 case HCI_STATE_OFF:
                     btstack_tlv_posix_deinit(&tlv_context);
                     if (!shutdown_triggered) break;
@@ -213,6 +224,8 @@
 }
 
 int main(int argc, const char * argv[]){
+
+    setvbuf(stdout, NULL, _IOLBF, 0);
 
     const char * log_file_path = NULL;
 
@@ -258,10 +271,14 @@
 
         log_file_path = pklg_path;
     }
-    hci_dump_posix_fs_open(log_file_path, HCI_DUMP_PACKETLOGGER);
-    const hci_dump_t * hci_dump_impl = hci_dump_posix_fs_get_instance();
-    hci_dump_init(hci_dump_impl);
-    printf("Packet Log: %s\n", log_file_path);
+    if (strcmp(log_file_path, "none") != 0){
+        hci_dump_posix_fs_open(log_file_path, HCI_DUMP_PACKETLOGGER);
+        const hci_dump_t * hci_dump_impl = hci_dump_posix_fs_get_instance();
+        hci_dump_init(hci_dump_impl);
+        printf("Packet Log: %s\n", log_file_path);
+    } else {
+        printf("Packet Log: disabled\n");
+    }
     printf("Bluetooth device: hci%u\n", transport_config.device_id);
 
     // init HCI
