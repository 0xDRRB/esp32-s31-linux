-static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size){
+static void s31_coex_pump(void){
+    uint8_t op;
+    uint8_t status;
+
+    if (!s31_coex_enabled || !s31_coex_supported) return;
+
+    if (s31_coex_phase == S31_COEX_IDLE){
+        if (s31_coex_desired_streaming == s31_coex_applied_streaming) return;
+        s31_coex_transition_streaming = s31_coex_desired_streaming;
+        s31_coex_phase = S31_COEX_SEND_STREAMING;
+    }
+    if (!hci_can_send_command_packet_now()) return;
+
+    switch (s31_coex_phase){
+        case S31_COEX_SEND_STREAMING:
+            op = s31_coex_transition_streaming ?
+                S31_ESP_COEX_OP_SET : S31_ESP_COEX_OP_CLEAR;
+            status = hci_send_cmd(&s31_esp_coex_status_cmd,
+                                  S31_ESP_COEX_TYPE_BT, op,
+                                  S31_ESP_COEX_A2DP_STREAMING);
+            if (status == ERROR_CODE_SUCCESS){
+                s31_coex_phase = S31_COEX_WAIT_STREAMING;
+            }
+            break;
+        case S31_COEX_SEND_PAUSED:
+            status = hci_send_cmd(&s31_esp_coex_status_cmd,
+                                  S31_ESP_COEX_TYPE_BT,
+                                  S31_ESP_COEX_OP_CLEAR,
+                                  S31_ESP_COEX_A2DP_PAUSED);
+            if (status == ERROR_CODE_SUCCESS){
+                s31_coex_phase = S31_COEX_WAIT_PAUSED;
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+static void s31_coex_request(bool streaming){
+    if (!s31_coex_enabled || !s31_coex_supported) return;
+    s31_coex_desired_streaming = streaming;
+    s31_coex_pump();
+}
+
+static void s31_coex_command_complete(uint8_t *packet, uint16_t size){
+    uint8_t status;
+
+    if (!s31_coex_enabled || size < 6) return;
+    if (hci_event_command_complete_get_command_opcode(packet) !=
+        S31_ESP_COEX_STATUS_OPCODE) return;
+
+    status = hci_event_command_complete_get_return_parameters(packet)[0];
+    if (s31_coex_phase != S31_COEX_WAIT_STREAMING &&
+        s31_coex_phase != S31_COEX_WAIT_PAUSED){
+        printf("S31 coexistence: unexpected 0xfc82 completion status 0x%02x\n",
+               status);
+        return;
+    }
+    if (status != ERROR_CODE_SUCCESS){
+        s31_coex_supported = false;
+        s31_coex_phase = S31_COEX_IDLE;
+        printf("S31 coexistence: controller rejected 0xfc82; updates disabled\n");
+        return;
+    }
+
+    if (s31_coex_phase == S31_COEX_WAIT_STREAMING){
+        s31_coex_phase = S31_COEX_SEND_PAUSED;
+    } else {
+        s31_coex_applied_streaming = s31_coex_transition_streaming;
+        s31_coex_phase = S31_COEX_IDLE;
+    }
+    s31_coex_pump();
+}
+
+static void s31_sm_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size){
     UNUSED(channel);
     UNUSED(size);
     if (packet_type != HCI_EVENT_PACKET) return;
+    switch (hci_event_packet_get_type(packet)){
+        case SM_EVENT_JUST_WORKS_REQUEST:
+            /* NoIO appliance: no user exists to confirm.  Same policy
+             * as the Classic SSP auto-accept in hci_packet_handler. */
+            sm_just_works_confirm(sm_event_just_works_request_get_handle(packet));
+            break;
+        default:
+            break;
+    }
+}
+
+static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size){
+    UNUSED(channel);
+    if (packet_type != HCI_EVENT_PACKET) return;
 
     bd_addr_t address;
     switch (hci_event_packet_get_type(packet)){
+        case BTSTACK_EVENT_STATE:
+            if (btstack_event_state_get_state(packet) == HCI_STATE_WORKING){
+                // Match ESP-IDF Bluedroid defaults after BTstack's HCI reset.
+                // Earlier calls are erased by hci_state_reset().
+                gap_set_page_scan_activity(0x0800, 0x0012);
+                gap_inquiry_set_scan_activity(0x1000, 0x0012);
+            }
+            break;
+        case HCI_EVENT_CONNECTION_COMPLETE:
+            if (hci_event_connection_complete_get_status(packet) == ERROR_CODE_SUCCESS &&
+                hci_event_connection_complete_get_link_type(packet) == 1){
+                hci_con_handle_t handle =
+                    hci_event_connection_complete_get_connection_handle(packet);
+                uint16_t usable_packet_types = hci_usable_acl_packet_types();
+                uint16_t packet_types =
+                    ACL_PACKET_TYPES_DM1 |
+                    (usable_packet_types & (ACL_PACKET_TYPES_DM5 |
+                                             ACL_PACKET_TYPES_DH5 | 0x3000)) |
+                    ACL_PACKET_TYPES_2DH1 | ACL_PACKET_TYPES_3DH1 |
+                    ACL_PACKET_TYPES_2DH3 | ACL_PACKET_TYPES_3DH3;
+
+                hci_send_cmd(&hci_change_connection_packet_type,
+                             handle, packet_types);
+            }
+            break;
+        case HCI_EVENT_COMMAND_COMPLETE: {
+            s31_coex_command_complete(packet, size);
+            break;
+        }
         case HCI_EVENT_PIN_CODE_REQUEST:
             // inform about legacy pairing with pin code - should only happen before Core v2.1
             printf("Pin code request for Legacy Pairing received -> abort pairing'\n");
@@ -696,6 +956,7 @@
         default:
             break;
     }
+    s31_coex_pump();
 }
 
