+/* Keep one literal name across Classic discovery, BLE scan response and GAP.
+ * Legacy scan responses have 31 bytes, of which two describe the name field. */
+#define S31_BTSTACK_NAME_MAX 29
+static char s31_device_name[S31_BTSTACK_NAME_MAX + 1] = "S31 Radio";
+
+static void s31_load_device_name(void){
+    const char * name = getenv("S31_BTSTACK_NAME");
+    if (name == NULL) return;
+    size_t length = strlen(name);
+    if (length == 0 || length > S31_BTSTACK_NAME_MAX){
+        fprintf(stderr, "BTstack: invalid device name length; using S31 Radio\n");
+        return;
+    }
+    for (size_t i = 0; i < length; ++i){
+        uint8_t c = (uint8_t) name[i];
+        if (c < 0x20 || c == 0x7f){
+            fprintf(stderr, "BTstack: control character in device name; using S31 Radio\n");
+            return;
+        }
+    }
+    memcpy(s31_device_name, name, length + 1);
+}
