+#define S31_HCI_BATCH_PACKETS 8
+#define S31_HCI_BATCH_RECORD_SIZE (2 + HCI_INCOMING_PACKET_BUFFER_SIZE + 1)
+static uint8_t s31_hci_batch[S31_HCI_BATCH_PACKETS * S31_HCI_BATCH_RECORD_SIZE];
