@@ -187,19 +341,64 @@
     uint32_t  buffer_size = size + 1;
     buffer[0] = packet_type;
 
-    if (write(hci_socket, buffer, buffer_size) < 0) {
+    if (s31_tx_batch_limit && buffer_size <= 1029 &&
+        s31_tx_batch_frames < s31_tx_batch_limit && !s31_tx_batch_retry) {
+        int immediate = (packet_type != HCI_ACL_DATA_PACKET) ||
+                        s31_tx_batch_frames + 1 == s31_tx_batch_limit;
+        btstack_assert(s31_tx_batch_size + 2 + buffer_size <= sizeof(s31_tx_batch));
+        s31_tx_batch[s31_tx_batch_size++] = buffer_size & 0xff;
+        s31_tx_batch[s31_tx_batch_size++] = buffer_size >> 8;
+        memcpy(s31_tx_batch + s31_tx_batch_size, buffer, buffer_size);
+        s31_tx_batch_size += buffer_size;
+        s31_tx_batch_frames++;
+        /* Commands flush ahead of themselves so control latency never waits
+         * behind bulk ACL; a full batch always flushes synchronously.
+         * Partial appends complete immediately so the pump keeps flowing;
+         * a synchronously flushed record completes only on kernel accept. */
+        if (immediate) {
+            s31_tx_batch_fill_owed = 1;
+            s31_tx_batch_flush();
+        } else {
+            s31_tx_batch_arm_tail();
+            s31_tx_batch_complete(1);
+        }
+        return 0;
