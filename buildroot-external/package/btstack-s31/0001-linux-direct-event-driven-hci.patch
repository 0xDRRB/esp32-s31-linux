 // linux hci socket
 static int hci_socket = -1;
 
+static uint8_t * hci_pending_write;
+static uint32_t hci_pending_write_size;
+static int hci_can_send;
+static btstack_context_callback_registration_t hci_packet_sent_registration;
+
+/* S31 TX write coalescing: accumulate H4 records (up to eight), flush on a
+ * full batch, a non-ACL packet (commands never wait behind bulk ACL), or a
+ * write-ready event at the next event-loop boundary. No tail delay.
+ * Copied partial records release caller buffers; final-full-batch release
+ * waits for kernel acceptance. Controller credits and FIFO are unchanged.
+ * Native envelope support is required at open. */
+#define S31_TX_BATCH_MAX 8
+#define S31_TX_BATCH_RECORD_MAX (2 + HCI_OUTGOING_PACKET_BUFFER_SIZE + 1)
+#define S31_TX_ENVELOPE_IOCTL _IOR('S', 0x31, uint32_t)
+static uint8_t s31_tx_single[1 + S31_TX_BATCH_RECORD_MAX];
+static uint8_t s31_tx_batch[1 + S31_TX_BATCH_MAX * S31_TX_BATCH_RECORD_MAX];
+static unsigned s31_tx_batch_limit;
+static unsigned s31_tx_batch_frames;
+static unsigned s31_tx_batch_size;
+static unsigned s31_tx_batch_retry;
+static unsigned s31_tx_batch_fill_owed;
+
 static const hci_transport_config_linux_t * hci_transport_config_linux;
+
+static void hci_transport_linux_emit_packet_sent(void * context) {
+    UNUSED(context);
+    static const uint8_t packet_sent_event[] = { HCI_EVENT_TRANSPORT_PACKET_SENT, 0 };
+
+    hci_can_send = 1;
+    hci_transport_linux_packet_handler(HCI_EVENT_PACKET,
+                                       (uint8_t *) packet_sent_event,
+                                       sizeof(packet_sent_event));
+}
+
+static void hci_transport_linux_schedule_packet_sent(void) {
+    hci_packet_sent_registration.callback = &hci_transport_linux_emit_packet_sent;
+    hci_packet_sent_registration.context = NULL;
+    btstack_run_loop_execute_on_main_thread(&hci_packet_sent_registration);
+}
+
+static unsigned s31_tx_batch_flush(void);
+
+static void s31_tx_batch_complete(unsigned count) {
+    while (count--) {
+        hci_transport_linux_schedule_packet_sent();
+    }
+}
+
+/* Drain local packet-sent callbacks first, then let select report actual
+ * device space. A short batch never waits for another packet or a timer. */
+static void s31_tx_batch_arm_tail(void) {
+    btstack_run_loop_enable_data_source_callbacks(&hci_transport_linux_data_source,
+                                                   DATA_SOURCE_CALLBACK_WRITE);
+}
+
+static void s31_tx_batch_disarm_tail(void) {
+    btstack_run_loop_disable_data_source_callbacks(&hci_transport_linux_data_source,
+                                                    DATA_SOURCE_CALLBACK_WRITE);
+}
+
+static unsigned s31_tx_batch_flush(void) {
+    ssize_t n;
+    unsigned pos, done = 0;
+
+    if (!s31_tx_batch_limit || s31_tx_batch_frames == 0) return 0;
+    s31_tx_batch_disarm_tail();
+    n = write(hci_socket, s31_tx_batch, s31_tx_batch_size);
+    if (n < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            s31_tx_batch_retry = 1;
+            btstack_run_loop_enable_data_source_callbacks(&hci_transport_linux_data_source,
+                                                           DATA_SOURCE_CALLBACK_WRITE);
+            return 0;
+        }
+        perror("S31 batch write");
+        return 0;
+    }
+    btstack_assert(n > 1 && (unsigned) n <= s31_tx_batch_size);
+    pos = 1;
+    while (pos < (unsigned) n) {
+        pos += 2 + s31_tx_batch[pos] + ((unsigned) s31_tx_batch[pos + 1] << 8);
+        done++;
+    }
+    btstack_assert(pos == (unsigned) n && done <= s31_tx_batch_frames);
+    if ((unsigned) n < s31_tx_batch_size) {
+        memmove(s31_tx_batch + 1, s31_tx_batch + n, s31_tx_batch_size - n);
+        s31_tx_batch_size -= (unsigned) n - 1;
+        s31_tx_batch_frames -= done;
+        s31_tx_batch_retry = 1;
+        btstack_run_loop_enable_data_source_callbacks(&hci_transport_linux_data_source,
+                                                       DATA_SOURCE_CALLBACK_WRITE);
+        return done;
+    }
+    s31_tx_batch_frames = 0;
+    s31_tx_batch_size = 1;
+    s31_tx_batch_retry = 0;
+    if (s31_tx_batch_fill_owed) {
+        s31_tx_batch_fill_owed = 0;
+        s31_tx_batch_complete(1);
+    }
+    return done;
+}
+
+static void hci_transport_linux_process_write(btstack_data_source_t * ds) {
+    ssize_t bytes_written;
+
+    /* A READ callback in the same select result can synchronously drain the
+     * batch and withdraw WRITE interest. Ignore that stale readiness value. */
+    if (!s31_tx_batch_frames && !s31_tx_batch_retry && !hci_pending_write) {
+        btstack_run_loop_disable_data_source_callbacks(ds, DATA_SOURCE_CALLBACK_WRITE);
+        return;
+    }
+
+    if (s31_tx_batch_limit && (s31_tx_batch_frames || s31_tx_batch_retry)) {
+        btstack_run_loop_disable_data_source_callbacks(ds, DATA_SOURCE_CALLBACK_WRITE);
+        s31_tx_batch_flush();
+        return;
+    }
+    btstack_assert(hci_pending_write != NULL);
+    bytes_written = write(hci_socket, hci_pending_write, hci_pending_write_size);
+    if (bytes_written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+    if (bytes_written < 0) {
+        perror("Failed to retry HCI packet");
+        return;
+    }
+    btstack_assert((uint32_t) bytes_written == hci_pending_write_size);
+    hci_pending_write = NULL;
+    hci_pending_write_size = 0;
+    btstack_run_loop_disable_data_source_callbacks(ds, DATA_SOURCE_CALLBACK_WRITE);
+    hci_transport_linux_schedule_packet_sent();
+}
 
 static void hci_transport_linux_process_read(btstack_data_source_t * ds) {
     UNUSED(ds);
-
-    int bytes_read = read(hci_socket, hci_packet, HCI_INCOMING_PACKET_BUFFER_SIZE);
+    int packets;
+    size_t offset = 0;
+
+    int bytes_read = read(hci_socket, s31_hci_batch, sizeof(s31_hci_batch));
     if (bytes_read < 0) {
-        perror("Failed to read HCI packet");
