Subject: [PATCH] SCO demo: report real HCI status and accepted sends

--- a/sco_demo_util.c
+++ b/sco_demo_util.c
@@ -545,18 +545,21 @@
 
 void sco_demo_receive(uint8_t * packet, uint16_t size){
     static uint32_t packets = 0;
-    static uint32_t crc_errors = 0;
+    static uint32_t status_errors = 0;
     static uint32_t data_received = 0;
-    static uint32_t byte_errors = 0;
-
+
+    if (size < 3 || size != 3u + packet[2]) {
+        printf("S31-SCO-MALFORMED size=%u\n", (unsigned int)size);
+        return;
+    }
+    status_errors += (packet[1] & 0x30) != 0;
     count_received++;
 
     data_received += size - 3;
     packets++;
     if (data_received > 100000){
-        printf("Summary: data %07u, packets %04u, packet with crc errors %0u, byte errors %04u\n",  (unsigned int) data_received,  (unsigned int) packets, (unsigned int) crc_errors, (unsigned int) byte_errors);
-        crc_errors = 0;
-        byte_errors = 0;
+        printf("S31-SCO-RX-WINDOW bytes=%u packets=%u status_errors=%u\n", (unsigned int)data_received, (unsigned int)packets, (unsigned int)status_errors);
+        status_errors = 0;
         data_received = 0;
         packets = 0;
     }
@@ -582,11 +585,15 @@
     // set len
     sco_packet[2] = sco_payload_length;
     // finally send packet
-    hci_send_sco_packet_buffer(sco_packet_length);
+    uint8_t send_status = hci_send_sco_packet_buffer(sco_packet_length);
 
     // request another send event
     hci_request_sco_can_send_now_event_for_con_handle(sco_handle);
 
+    if (send_status != ERROR_CODE_SUCCESS) {
+        printf("S31-SCO-TX-ERROR status=0x%02x\n", send_status);
+        return;
+    }
     count_sent++;
     if ((count_sent % SCO_REPORT_PERIOD) == 0) {
         printf("SCO: sent %u, received %u\n", count_sent, count_received);
